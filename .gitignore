# ---------------------------------------------------------------------
# Bundled third-party tools -- not ours to redistribute.
#
# build.ps1 expects both of these to exist. See README.md:
#   acme/      ACME 0.97   https://sourceforge.net/projects/acme-crossass/
#   emulator/  x16emu r49  https://github.com/X16Community/x16-emulator
#              (needs rom.bin from https://github.com/X16Community/x16-rom)
# ---------------------------------------------------------------------
acme/
emulator/

# ---------------------------------------------------------------------
# Official X16 reference documents -- freely available upstream, kept
# locally for offline use. The ForthX16 help pages in doc/*.TXT stay.
# ---------------------------------------------------------------------
doc/Commander X16 Programmer's Reference Guide.pdf
doc/X16 Reference - 09 - VERA Programmer's Reference.md
doc/X16 Reference - 10 - VERA FX Reference.md
doc/*.pdf

*.d64
*.prg
*.crt
*.nvram

# build/ holds generated outputs (kernel image, card sources, .crt, etc.) but
# also the build SCRIPTS that build.sh / run-tests.sh call - keep those two.
build/*
!build/mkcard.py
!build/annotate.py
!build/extract-durexfth.py
!build/parencheck.py
deploy

# release/ holds the published binaries for users who don't rebuild - commit
# ALL of them (these re-include past the *.prg / *.crt / *.img ignores above),
# except the stray makecart .nvram files.
!release/
!release/*
release/*.nvram

# ...with ONE exception, added when the MiSTer tree arrived. The rule above
# was written for the C64 artifacts, which are ~200 KB and change when the
# Forth does. release/mister/ is 68 MB - a 64 MB FAT32 card image plus a
# 4 MB bitstream - and CLAUDE.md says to regenerate it after EVERY change,
# so tracking it would add 68 MB to history per refresh and git never
# forgets. Both are pure outputs of ../X816_core/tools/mkrelease.sh.
#
# The two ROMs stay: they are 54 KB together, they are what actually gets
# flashed when only the kernel or shell moved, and having them in history
# tells you which kernel a given Forth commit was proven against.
!release/mister/
!release/mister/*
release/mister/games/X816/boot0.img
release/mister/_Computer/
!release/mister/games/
!release/mister/games/X816/
!release/mister/games/X816/*.rom



# Emulator memory dumps (x16emu writes these next to the working dir)
dump-*.bin
